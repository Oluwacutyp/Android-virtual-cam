<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="VCAM STUDIO"
            android:textColor="#3DDC84"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○ Idle"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="#33FFFFFF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="3"
        android:layout_marginTop="8dp"
        android:useDefaultMargins="true">

        <Button
            android:id="@+id/widget_btn_vcam"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="▶ Start VCam"
            android:textSize="11sp"
            android:backgroundTint="#03DAC6"
            android:textColor="#000000" />

        <Button
            android:id="@+id/widget_btn_stream"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="▶ Stream"
            android:textSize="11sp"
            android:backgroundTint="#3DDC84"
            android:textColor="#000000" />

        <Button
            android:id="@+id/widget_btn_record"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="● Record"
            android:textSize="11sp"
            android:backgroundTint="#FF5252"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/widget_btn_replay"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="⏪ Replay"
            android:textSize="11sp"
            android:backgroundTint="#FFA000"
            android:textColor="#000000" />

        <Button
            android:id="@+id/widget_btn_save_clip"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnSpan="2"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="💾 SAVE CLIP"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#FF5252"
            android:textColor="#FFFFFF" />

    </GridLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap header to open app • Quick toggle without opening"
        android:textColor="#888888"
        android:textSize="9sp"
        android:layout_marginTop="6dp"
        android:gravity="center" />

</LinearLayout>
